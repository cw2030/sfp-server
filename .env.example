# 注：配置以 app.yaml 为主，环境变量为可选覆盖（同名变量优先级高于 app.yaml）。
# 可用 CONFIG_FILE 指定其他 YAML 配置文件路径。
# 以下仅列出与 app.yaml 对应的环境变量，留空即沿用 app.yaml 的值。

# MySQL 连接串（必须）
DATABASE_URL=mysql://sftp_user:your_password@127.0.0.1:3306/sftp_db

# SFTP 监听地址（不要用22，避免与系统sshd冲突）
SFTP_BIND=0.0.0.0:2222

# HTTP 管理 API，默认仅监听本机，通过 Nginx 反向代理对外
HTTP_BIND=127.0.0.1:8080

# 后台 JWT 签名密钥（务必修改为强随机串）
JWT_SECRET=please-change-to-a-long-random-secret
JWT_EXPIRE_HOURS=12

# SFTP 主机私钥文件路径，不存在时自动生成（生产建议备份）
HOST_KEY_PATH=host_key

# 日志目录
LOG_DIR=logs

# admin_user 表为空时自动创建的默认管理员
ADMIN_USER=admin
ADMIN_PASSWORD=Admin@123456
